{
  "name": "wonju-bus",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm --filter @wonju-bus/crawl build && pnpm --filter @wonju-bus/site build",
    "dev": "pnpm --filter @wonju-bus/site dev",
    "lint": "pnpm --filter @wonju-bus/site lint",
    "crawl": "pnpm --filter @wonju-bus/crawl run sync-site-data",
    "start:crawl": "pnpm --filter @wonju-bus/crawl start",
    "start:site": "pnpm --filter @wonju-bus/site start",
    "crawl:publish": "pnpm --filter @wonju-bus/crawl publish-data",
    "db:migrate": "pnpm --filter @wonju-bus/crawl db:migrate",
    "test": "pnpm --filter @wonju-bus/crawl test:session && pnpm test:logic && node scripts/check-project.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "build:apk": "cd apps/flutter && flutter build apk --release && cd ../.. && node scripts/package-android-release.mjs",
    "test:logic": "pnpm --filter @wonju-bus/crawl exec ts-node --project ../../scripts/tsconfig.tests.json ../../scripts/test-schedules.ts",
    "holidays:sync": "pnpm --filter @wonju-bus/crawl exec ts-node --project ../../scripts/tsconfig.tests.json ../../scripts/sync-holidays.ts"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
